									"x-ms-version": "2020-10-02"
								},
								"url": {
									"value": "https://elswedenpriceproject.blob.core.windows.net/entsoe-raw/entsoe/day_ahead/@{item().ZoneName}/@{formatDateTime(utcnow(), 'yyyy')}/@{item().ZoneName}_@{formatDateTime(utcnow(), 'yyyyMMdd')}.xml",
