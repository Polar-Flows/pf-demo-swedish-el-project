								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"method": "GET",
								"headers": {
									"Accept": "application/xml"
								},
								"url": {
									"value": "https://web-api.tp.entsoe.eu/api?securityToken=d62beab7-0eb5-4da4-8854-40313af924aa&documentType=A44&in_Domain=@{item().ZoneCode}&out_Domain=@{item().ZoneCode}&periodStart=@{formatDateTime(utcnow(), 'yyyyMMdd0000')}&periodEnd=@{formatDateTime(addDays(utcnow(), 1), 'yyyyMMdd0000')}",
									"type": "Expression"
