{
	"name": "pl_entseo_daily",
	"properties": {
		"activities": [
			{
				"name": "ForEach-daily",
				"type": "ForEach",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@pipeline().parameters.pBackfillList",
						"type": "Expression"
