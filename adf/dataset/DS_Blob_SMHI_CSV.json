{
	"name": "DS_Blob_SMHI_CSV",
	"properties": {
		"linkedServiceName": {
			"referenceName": "ls_blob_storage",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"Zone": {
				"type": "string"
			},
			"Param": {
				"type": "string"
			},
			"ParamName": {
				"type": "string"
			},
			"Station": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "Binary",
		"typeProperties": {
			"location": {
				"type": "AzureBlobStorageLocation",
				"fileName": "@concat('param_', dataset().Param, '_', dataset().ParamName, '_station_', dataset().Station, '.csv')",
				"folderPath": "@concat('metobs/corrected_archive/', dataset().Zone)",
				"container": "smhi"
			}
		}
	}
}