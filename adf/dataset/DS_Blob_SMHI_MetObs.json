{
	"name": "DS_Blob_SMHI_MetObs",
	"properties": {
		"linkedServiceName": {
			"referenceName": "ls_blob_storage",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"Zone": {
				"type": "string"
			},
			"Param": {
				"type": "string"
			},
			"ParamName": {
				"type": "string"
			},
			"Station": {
				"type": "string"
			},
			"Period": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "Binary",
		"typeProperties": {
			"location": {
				"type": "AzureBlobStorageLocation",
				"fileName": "@concat('param_', dataset().Param, '_', dataset().ParamName, '_station_', dataset().Station, '_', dataset().Period, '_', formatDateTime(utcnow(), 'yyyyMMdd'), '.json')",
				"folderPath": "@concat('metobs/daily/', dataset().Zone, '/', formatDateTime(utcnow(), 'yyyy'))",
				"container": "smhi"
			}
		}
	}
}